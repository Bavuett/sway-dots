# swaylock — pastel lockscreen (vanilla swaylock: no clock, no blur)
image=~/.config/sway/wallpaper.jpg
scaling=fill
color=1e1a2e

font=JetBrainsMono Nerd Font
font-size=22
indicator-radius=110
indicator-thickness=8
show-failed-attempts
ignore-empty-password

inside-color=1e1a2ecc
inside-clear-color=1e1a2ecc
inside-ver-color=1e1a2ecc
inside-wrong-color=1e1a2ecc

ring-color=f5b8c6cc
ring-clear-color=aec6cfcc
ring-ver-color=fffaa0cc
ring-wrong-color=f5b8b8cc

key-hl-color=ff3db5ff
bs-hl-color=f2aeb8ff

line-uses-inside
separator-color=00000000

text-color=f2e8f5ff
text-clear-color=aec6cfff
text-ver-color=fffaa0ff
text-wrong-color=f5b8b8ff
